# Шаблон переменных окружения MindTrace.
# Скопируй в `.env` (он в .gitignore) и заполни. Значения-подсказки ориентированы на PROD.
# Секреты НЕ коммить: реальный .env живёт только на сервере.
#
# Один .env читают и docker compose (POSTGRES_*, GRAFANA_*, HOST/PORT), и backend (pydantic-settings).

# ── Приложение ──
ENVIRONMENT=production          # local | development | production (в prod скрывает /docs и OpenAPI)
HOST=0.0.0.0
PORT=8000                       # порт внутри контейнера; наружу проксирует Caddy, не публикуем напрямую
# Hot-reload только для локальной разработки. ОСТАВЬ ПУСТЫМ для prod.
# ВАЖНО: compose включает --reload при ЛЮБОМ непустом значении (даже "false"), поэтому именно пусто.
RELOAD=

# ── PostgreSQL ──
POSTGRES_USER=mindtrace
POSTGRES_PASSWORD=              # СГЕНЕРИРУЙ: `openssl rand -base64 32`
POSTGRES_DB=mindtrace
POSTGRES_HOST=mindtrace_pg      # имя сервиса БД в compose-сети (для локального uv-запуска — localhost)
POSTGRES_PORT=5432
POSTGRES_ECHO=false             # SQL-эхо в логи; в prod всегда false

# ── JWT ──
JWT_SECRET_KEY=                 # СГЕНЕРИРУЙ: `openssl rand -hex 32` (в prod — НОВЫЙ, не из dev)

# ── Resend (отправка email) ──
RESEND_API_KEY=                 # ключ из https://resend.com
RESEND_FROM_EMAIL=no-reply@example.com   # адрес на верифицированном в Resend домене (SPF/DKIM)

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=         # СГЕНЕРИРУЙ; Grafana наружу не публикуется без явной защиты

# ── Деплой (docker-compose.prod.yaml + Caddy) ──
DOMAIN=example.com              # домен приложения; A-запись должна указывать на IP VPS ДО старта Caddy
ACME_EMAIL=admin@example.com    # email для Let's Encrypt (уведомления об истечении сертификата)
IMAGE_TAG=latest                # тег образов из GHCR (CI выставляет sha; latest — последний собранный)
