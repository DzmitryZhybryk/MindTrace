          "500": {
            "description": "Внутренняя ошибка сервера",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "internal",
                  "message": "Внутренняя ошибка сервера",
                  "timestamp": "2024-01-01T12:00:00Z"
                }
