  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Liveness-проба для контейнерного healthcheck и reverse-proxy.\n\nНамеренно не трогает БД и внешние сервисы — это liveness, а не readiness:\nконтейнер не должен уходить в рестарт из-за временной недоступности\nзависимостей (за переподключение отвечают пул и retry самих клиентов).\nПробы конкретных зависимостей (postgres, procrastinate) добавятся сюда\nотдельными readiness-эндпоинтами по мере необходимости.\n\nReturns:\n    Пустой ответ со статусом 200, если процесс обрабатывает запросы.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/": {
