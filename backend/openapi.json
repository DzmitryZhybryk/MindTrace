                      "details": {
                        "field": "email"
                      },
                      "timestamp": "2024-01-01T12:00:00Z"
                    }
                  },
                  "auth.username_already_taken": {
                    "summary": "Username уже занят",
                    "value": {
                      "code": "auth.username_already_taken",
                      "message": "Пользователь с таким username уже существует",
