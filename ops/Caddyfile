# Caddyfile — reverse-proxy + автоматический HTTPS (Let's Encrypt).
#
# ВАЖНО перед первым стартом:
#   1) DOMAIN (из .env) должен указывать A-записью на IP этого VPS.
#   2) Порты 80 и 443 доступны из интернета — Caddy берёт сертификат по ACME HTTP-01.
# Для локальной отладки прод-стека без домена задай в .env DOMAIN=localhost
# (Caddy выдаст самоподписанный внутренний сертификат).
{
	email {$ACME_EMAIL}
	# По голому IP клиент не шлёт SNI (IP нельзя в SNI по RFC) → без этого Caddy не может
	# подобрать сертификат и рвёт handshake (tls internal error). Подставляем {$DOMAIN} как
	# имя по умолчанию. Для реального домена безвредно — SNI там всегда есть.
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	encode zstd gzip

	# Security-заголовки на все ответы (и API, и статика). HSTS НЕ включаем: деплой по
	# голому IP с self-signed TLS — Strict-Transport-Security сломал бы доступ; включить
	# только на реальном домене с валидным сертификатом. -Server прячет "Server: Caddy"
	# (парно к server_tokens off в nginx).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# API -> backend (единственный origin: CORS не нужен)
	handle /v1/* {
		reverse_proxy app:8000
	}

	# Всё остальное -> статика фронта (nginx-unprivileged слушает :8080). handle-блоки взаимоисключающие.
	handle {
		reverse_proxy frontend:8080
	}
}
