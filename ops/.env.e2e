# Тестовые (НЕ секретные) значения для одноразового e2e-стека (ops/docker-compose.e2e.yaml).
#
# Postgres здесь — tmpfs (данные в RAM, гибнут на `down`), а Resend замокан на мёртвый адрес
# (worker в compose переопределяет RESEND_BASE_URL) → реальные сервисы не дёргаются, писем нет.
# Поэтому значения ниже — не секреты и коммитятся намеренно: e2e-стек должен подниматься на любой
# машине и в CI без личного dev-.env. НЕ использовать в dev/prod.
#
# В CI (prod.yml) этот файл копируется в корневой .env перед `make test-e2e` (стек ждёт env_file: .env).

ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
# e2e не нужен hot-reload. НЕ пусто: Settings.RELOAD — bool, пустая строка не парсится
# (в e2e-стеке ${RELOAD} в команду uvicorn не подставляется, значение уходит только в Settings).
RELOAD=false

# Postgres (POSTGRES_HOST = имя сервиса в compose, иначе app не найдёт БД)
POSTGRES_USER=mindtrace
POSTGRES_PASSWORD=mindtrace
POSTGRES_DB=mindtrace
POSTGRES_HOST=mindtrace_pg
POSTGRES_PORT=5432
POSTGRES_ECHO=false

# JWT — throwaway-секрет только для e2e
JWT_SECRET_KEY=e2e-only-not-a-real-secret-do-not-use-anywhere-else

# Resend — ключ-заглушка; worker в compose переопределяет RESEND_BASE_URL на мёртвый адрес
RESEND_API_KEY=e2e-dummy-not-secret
RESEND_FROM_EMAIL=no-reply@example.com
