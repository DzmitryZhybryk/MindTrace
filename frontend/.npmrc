# Жёстко сверять активные node/npm с полем "engines" в package.json (см. .nvmrc / Dockerfile:
# node:26-alpine, CI node-version 26). Без этого npm лишь предупреждает и молча ставит на любой
# версии — а npm разных мажоров по-разному нормализует package-lock.json (метадата optional-
# бинарников rollup/esbuild), из-за чего лок дрейфит между локалью и Docker/CI. engine-strict
# роняет install на несовпадении → тулчейн держится единым.
engine-strict=true
