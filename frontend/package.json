{
  "name": "frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage VITEST_SCOPE=unit vitest run",
    "test:component": "NODE_OPTIONS=--no-experimental-webstorage VITEST_SCOPE=component vitest run",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/form": "^9.4.1",
    "@mantine/hooks": "^9.0.2",
    "@types/three": "^0.185.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.73.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.8"
  }
}
