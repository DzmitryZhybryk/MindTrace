{
  "name": "frontend",
  "private": true,
  "version": "2.13.1",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "generate:api": "openapi-ts",
    "generate:world": "node scripts/build-world-topology.ts",
    "budget": "tsc -b && vite build --manifest && node scripts/check-bundle-budget.ts",
    "mantine-styles": "node scripts/check-mantine-styles.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage VITEST_SCOPE=unit vitest run",
    "test:component": "NODE_OPTIONS=--no-experimental-webstorage VITEST_SCOPE=component vitest run",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^5.2.3"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.0.2",
    "@tanstack/react-query": "^5.104.1",
    "@types/three": "^0.186.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.0.0-next-20260813201118",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "oxlint": "^1.87.0",
    "topojson-server": "3.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  }
}
