#!/usr/bin/env sh
#
# Мерж-гейт покрытия без CI: не даём запушить код с покрытием < 90%.
# Гоняет coverage обеих сторон (backend --cov-fail-under=90 + frontend vitest thresholds);
# при провале порога make возвращает ненулевой код → push блокируется.
#
# Активация (разово): make hooks   (== git config core.hooksPath .githooks)
# Обход в исключительном случае: git push --no-verify
#
set -e

echo "pre-push: coverage gate (backend + frontend, >= 90%)…"
make be-coverage
make fe-coverage
